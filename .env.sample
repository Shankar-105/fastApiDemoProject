EMAIL_PORT=587
EMAIL_SERVER=smtp.gmail.com

# base url
BASE_URL="http://127.0.0.1:8000"

# posts media folder
MEDIA_FOLDER="posts_media"

# max edit time of a msg
MAX_EDIT_TIME=15

# REDIS
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# CELERY + RABBITMQ
CELERY_BROKER_URL="amqp://guest:guest@localhost:5672//"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# AZURE BLOB STORAGE (optional for local development)
# Leave these empty to use local folder fallback storage.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_ACCOUNT_NAME=""

# RATE LIMITING (max hits per window in seconds)
# You can change these as you wish
RL_LOGIN_MAX=5
RL_LOGIN_WINDOW=600  # login retry window (10 min)
RL_SIGNUP_MAX=3
RL_SIGNUP_WINDOW=3600  # signup window (1 hour)
RL_FORGOT_PASSWORD_MAX=1
RL_FORGOT_PASSWORD_WINDOW=3600  # forgot-password window (1 hour)
RL_RESET_PASSWORD_MAX=1
RL_RESET_PASSWORD_WINDOW=3600  # public reset-password window (1 hour)
RL_CHANGE_PASSWORD_MAX=1
RL_CHANGE_PASSWORD_WINDOW=3600  # change-password OTP window (1 hour)
RL_RESET_PASSWORD_AUTH_MAX=5
RL_RESET_PASSWORD_AUTH_WINDOW=300  # authenticated reset window (5 min)
RL_COMMENT_MAX=10
RL_COMMENT_WINDOW=3600  # comment creation window (1 hour)
RL_CREATE_POST_MAX=5
RL_CREATE_POST_WINDOW=600  # post creation window (10 min)
RL_FOLLOW_MAX=20
RL_FOLLOW_WINDOW=450  # follow/unfollow action window (7.5 min)

# OBSERVABILITY
# Set to true only when you want verbose OpenTelemetry span JSON in console.
OTEL_CONSOLE_EXPORTER_ENABLED=false
# Set to false if you want to mute custom [OBS] middleware request logs.
OBSERVABILITY_LOG_ENABLED=fasle

# Disable observability overhead during benchmarks (removes OTel span JSON, removes middleware logs)
BENCHMARK_MODE_ENABLED=true

# Number of Gunicorn worker processes (typical: 2-4 for dev/prod, more for high-traffic servers)
GUNICORN_WORKERS=2
# Worker timeout in seconds (kill and restart workers that hang longer than this)
GUNICORN_TIMEOUT=120
# HTTP keep-alive timeout in seconds overriden by uvicorn timeout(balance: too high = socket exhaustion, too low = reconnect churn)
GUNICORN_KEEPALIVE=5
# OS socket listen backlog for pending connections (too low = drops request bursts, too high = hides saturation)
GUNICORN_BACKLOG=2048
# Event loop for uvicorn: "auto" | "asyncio" | "uvloop"
UVICORN_LOOP=auto
# HTTP parser for uvicorn: "auto" | "h11" | "httptools"
UVICORN_HTTP=httptools
# HTTP keep-alive timeout by uvicorn
UVICORN_TIMEOUT_KEEP_ALIVE=5