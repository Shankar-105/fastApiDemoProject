// --- LOGS PIPELINE (Loki) ---

// Discover Docker containers for observability.
discovery.docker "linux" {
  host = "unix:///var/run/docker.sock"
}

// Discover only the FastAPI API container for the Loki dashboard.
discovery.docker "api" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.service=api"]
  }
}

// Scrape logs from discovered containers
loki.source.docker "local_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.api.targets
  labels     = {container = "api"}
  forward_to = [loki.process.production_logs.receiver]
}

// Process logs for PRODUCTION (JSON)
loki.process "production_logs" {
  forward_to = [loki.write.local_loki.receiver]

  // Try to parse as JSON (standard for production)
  stage.json {
    expressions = {
      level      = "level",
      message    = "message",
      req_id     = "request_id",
      user_id    = "user_id",
      trace_id   = "trace_id",
      err_code   = "error_code",
    }
  }

  // Set labels from the parsed JSON
  stage.labels {
    values = {
      level    = null,
      req_id   = null,
      user_id  = null,
      trace_id = null,
      err_code = null,
    }
  }
}

// Ship to Loki
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// --- METRICS PIPELINE (Prometheus) ---

// Scrape metrics from FastAPI
prometheus.scrape "fastapi" {
  scrape_interval = "15s"
  targets = [
    {"__address__" = "api:8000"},
  ]
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.local_prometheus.receiver]
}

// Scrape metrics from Alloy itself
prometheus.scrape "alloy" {
  scrape_interval = "15s"
  targets = [
    {"__address__" = "localhost:12345"},
  ]
  forward_to = [prometheus.remote_write.local_prometheus.receiver]
}

// Ship to Prometheus via Remote Write
prometheus.remote_write "local_prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// --- TRACES PIPELINE (Tempo) ---

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
      insecure_skip_verify = true
    }
  }
}
